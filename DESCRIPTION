Package: BioTransition
Type: Package
Title: Dynamic Network Biomarker Analysis for Critical Transitions
Version: 2.1.0
Date: 2026-06-15
Authors@R: c(
    person("Zaoqu", "Liu",
        email = "liuzaoqu@163.com",
        role = c("aut", "cre"),
        comment = c(ORCID = "0000-0002-0452-742X")),
    person("Chuhan", "Zhang",
