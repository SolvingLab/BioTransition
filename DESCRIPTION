Package: BioTransition
Type: Package
Title: Dynamic Network Biomarker Analysis for Critical Transition Detection
Version: 2.0.0
Date: 2026-01-23
Authors@R: c(
    person("Zaoqu", "Liu", 
        email = "liuzaoqu@163.com",
        role = c("aut", "cre"),
